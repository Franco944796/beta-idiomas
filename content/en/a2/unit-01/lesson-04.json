    "writing"
  ],
  "warmup": {
    "prompt_es": "'¿Fuiste?' 'No fui.' En inglés el trabajo de marcar el pasado lo hace un solo auxiliar: did."
  },
  "input": {
    "type": "dialogue",
    "lines": [
      {
        "speaker": "Tom",
        "text": "Did you go out last night?",
        "es": "¿Saliste anoche?"
      },
      {
        "speaker": "Anna",
        "text": "Yes, I did. I went to the cinema.",
        "es": "Sí. Fui al cine."
      },
      {
        "speaker": "Tom",
        "text": "Did you see a good film?",
        "es": "¿Viste una buena película?"
      },
      {
        "speaker": "Anna",
        "text": "No, I didn't. It wasn't very good.",
        "es": "No. No era muy buena."
      },
      {
        "speaker": "Tom",
        "text": "What a pity! Did your friends come with you?",
        "es": "¡Qué pena! ¿Tus amigos fueron contigo?"
      },
      {
        "speaker": "Anna",
        "text": "No, they didn't. They stayed at home.",
        "es": "No. Se quedaron en casa."
      }
    ],
