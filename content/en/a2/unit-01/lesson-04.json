  "title": {
    "target": "I didn't go. Did you go?",
    "es": "Pasado simple: negativas y preguntas"
  },
  "objective": "Al terminar niegas y preguntas en pasado con didn't y Did…? y das respuestas cortas.",
  "est_minutes": 27,
  "skills": [
    "grammar",
    "listening",
