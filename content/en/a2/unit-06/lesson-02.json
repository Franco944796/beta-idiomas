    "lines": [
      {
        "speaker": "Doctor",
        "text": "Good morning. What's the matter?",
        "es": "Buenos días. ¿Qué le pasa?"
      },
      {
        "speaker": "Patient",
        "text": "I've got a sore throat and a cough. I feel terrible.",
        "es": "Tengo dolor de garganta y tos. Me siento fatal."
      },
      {
        "speaker": "Doctor",
        "text": "When did it start?",
        "es": "¿Cuándo empezó?"
      },
      {
        "speaker": "Patient",
        "text": "Two days ago. And I've got a bit of a temperature.",
        "es": "Hace dos días. Y tengo un poco de fiebre."
      },
      {
        "speaker": "Doctor",
        "text": "Let me have a look. It's a cold. Take these tablets twice a day and drink lots of water.",
        "es": "Déjeme ver. Es un resfrío. Tome estas pastillas dos veces al día y beba mucha agua."
      },
      {
        "speaker": "Patient",
        "text": "Should I stay in bed?",
        "es": "¿Debería quedarme en cama?"
      },
      {
        "speaker": "Doctor",
        "text": "Yes, you should rest for a few days.",
        "es": "Sí, debería descansar unos días."
      }
    ],
