  "explanation": {
    "md_es": [
      "**Describir lo que te pasa**",
      "",
      "- *I've got a sore throat / a cough / a headache.*",
      "- *My stomach hurts.* · *I've got a pain in my back.*",
      "- **I feel + adjetivo**: *I feel ill / tired / dizzy / terrible / sick.*",
      "- *I've got a temperature.* (fiebre)",
      "",
      "**Preguntas del médico:** *What's the matter? · When did it start? · Do you have a temperature? · Are you allergic to anything?*",
      "",
      "**Instrucciones:** *Take these tablets twice a day. · Drink lots of water. · Stay in bed. · Come back in a week.*",
      "",
      "**Frecuencia:** *once a day (1) · twice a day (2) · three times a day (3) · every four hours.*",
      "",
      "**En la farmacia:** *Have you got anything for a cough? · Do I need a prescription? · How often should I take it?*",
      "",
      "**Ojo:** en inglés británico, *I feel sick* = tengo náuseas. Para 'estoy enfermo' usa *I'm ill*.",
      "",
      "Pronunciación: *temperature* /ˈtemprətʃə/ (tres sílabas) · *twice* /twaɪs/."
    ],
    "common_mistakes_es": [
      {
        "wrong": "I have pain in the head.",
        "right": "I've got a headache.",
        "note": "Usa la palabra headache."
      },
      {
        "wrong": "Take it two times in the day.",
        "right": "Take it twice a day.",
        "note": "Twice a day = dos veces al día."
      }
    ],
    "false_friends": []
  },
