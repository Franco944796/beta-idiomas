    "lines": [
      {
        "speaker": "Mum",
        "text": "Have you packed your suitcase yet?",
        "es": "¿Ya hiciste la maleta?"
      },
      {
        "speaker": "Tom",
        "text": "Yes, I've already packed it. I've just finished!",
        "es": "Sí, ya la hice. ¡Acabo de terminar!"
      },
      {
        "speaker": "Mum",
        "text": "Have you bought the tickets?",
        "es": "¿Compraste los pasajes?"
      },
      {
        "speaker": "Tom",
        "text": "Not yet. I haven't bought them yet. I'm going to buy them online now.",
        "es": "Todavía no. Aún no los compré. Los voy a comprar en línea ahora."
      },
      {
        "speaker": "Mum",
        "text": "Hurry up! The taxi has just arrived.",
        "es": "¡Apúrate! El taxi acaba de llegar."
      },
      {
        "speaker": "Tom",
        "text": "OK, I'm coming. I've already locked the door!",
        "es": "Bien, ya voy. ¡Ya cerré la puerta con llave!"
      }
    ],
