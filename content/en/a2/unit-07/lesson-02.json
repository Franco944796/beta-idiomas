  "title": {
    "target": "Now or every day?",
    "es": "Presente simple vs presente continuo"
  },
  "objective": "Al terminar distingues presente simple (rutinas y hechos) y presente continuo (ahora o algo temporal) y no usas verbos de estado en continuo.",
  "est_minutes": 28,
  "skills": [
    "grammar",
    "listening",
