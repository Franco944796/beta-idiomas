        "text": "Good evening. How can I help you?",
        "es": "Buenas noches. ¿En qué puedo ayudarlo?"
      },
      {
        "speaker": "Guest",
        "text": "Hello. I have a reservation under the name Garcia.",
        "es": "Hola. Tengo una reserva a nombre de García."
      },
      {
        "speaker": "Receptionist",
        "text": "Yes, a double room for three nights. Could I see your passport, please?",
        "es": "Sí, una habitación doble por tres noches. ¿Podría ver su pasaporte, por favor?"
      },
      {
        "speaker": "Guest",
        "text": "Of course. Here you are. Is breakfast included?",
        "es": "Por supuesto. Aquí tiene. ¿El desayuno está incluido?"
      },
      {
        "speaker": "Receptionist",
        "text": "Yes, it is. It's from seven to ten.",
        "es": "Sí. Es de siete a diez."
      },
      {
        "speaker": "Guest",
        "text": "Great. Could you tell me the Wi-Fi password, please?",
        "es": "Perfecto. ¿Podría decirme la contraseña del wifi, por favor?"
      }
