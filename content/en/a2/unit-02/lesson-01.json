  "explanation": {
    "md_es": [
      "**Antes del viaje:** *book* (reservar) a flight / a hotel · *pack* (hacer la maleta) · *a passport, a ticket, a map*.",
      "",
      "**En el lugar:** *go sightseeing* (hacer turismo) · *a tourist* · *the beach*.",
      "",
      "**Ojo con luggage:** es **incontable**: *My luggage is heavy.* (no *luggages*). Para contar: *a suitcase, two suitcases*.",
      "",
      "**Holiday vs vacation:** en inglés británico *holiday* = vacaciones; en inglés americano *vacation*. *Go on holiday / be on holiday*.",
      "",
      "Pronunciación: *luggage* /ˈlʌɡɪdʒ/ · *passport* /ˈpɑːspɔːt/ (la t final es suave) · *sightseeing* /ˈsaɪtsiːɪŋ/."
    ],
    "common_mistakes_es": [
      {
        "wrong": "I have three luggages.",
        "right": "I have three suitcases. / I have a lot of luggage.",
        "note": "Luggage no tiene plural."
      },
      {
        "wrong": "We made a trip with the plane.",
        "right": "We went on a trip by plane.",
        "note": "Se dice go on a trip y by plane."
      }
    ],
    "false_friends": [
      {
        "word": "actually",
        "es_false": "actualmente",
        "real": "en realidad",
        "note": "Actualmente se dice at the moment / currently."
      }
    ]
  },
