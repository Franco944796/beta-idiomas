  "title": {
    "target": "as ... as, too, enough",
    "es": "As...as, too y enough"
  },
  "objective": "Al terminar usas (not) as … as, too y enough para comparar igualdades y decir que algo es demasiado o suficiente.",
  "est_minutes": 27,
  "skills": [
    "grammar",
    "listening",
