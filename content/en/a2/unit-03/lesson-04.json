    "writing"
  ],
  "warmup": {
    "prompt_es": "'Tan caro como', 'demasiado ruidoso', 'lo bastante grande': tres formas más de comparar."
  },
  "input": {
    "type": "dialogue",
    "lines": [
      {
        "speaker": "Anna",
        "text": "Shall we eat here or at the Italian place?",
        "es": "¿Comemos aquí o en el restaurante italiano?"
      },
      {
        "speaker": "Ben",
        "text": "This one isn't as expensive as the Italian place.",
        "es": "Este no es tan caro como el italiano."
      },
      {
        "speaker": "Anna",
        "text": "True, but it's too noisy. I can't hear you!",
        "es": "Cierto, pero es demasiado ruidoso. ¡No te oigo!"
      },
      {
        "speaker": "Ben",
        "text": "The food here is as good as the food there.",
        "es": "La comida de aquí es tan buena como la de allá."
      },
      {
        "speaker": "Anna",
        "text": "Is this table big enough for four people?",
        "es": "¿Esta mesa es lo bastante grande para cuatro personas?"
      },
      {
        "speaker": "Ben",
        "text": "I think so. Let's stay. We don't have enough time to go anywhere else.",
        "es": "Creo que sí. Quedémonos. No tenemos suficiente tiempo para ir a otro lado."
      }
    ],
