    "lines": [
      {
        "speaker": "Tom",
        "text": "I called you at nine last night, but you didn't answer.",
        "es": "Te llamé a las nueve anoche, pero no atendiste."
      },
      {
        "speaker": "Lucy",
        "text": "Sorry, I was having a shower.",
        "es": "Perdón, me estaba duchando."
      },
      {
        "speaker": "Tom",
        "text": "And at ten? I sent you a message.",
        "es": "¿Y a las diez? Te mandé un mensaje."
      },
      {
        "speaker": "Lucy",
        "text": "I was talking to my sister on the phone. We were planning a trip.",
        "es": "Estaba hablando por teléfono con mi hermana. Estábamos planeando un viaje."
      },
      {
        "speaker": "Tom",
        "text": "Was she travelling alone?",
        "es": "¿Ella viajaba sola?"
      },
      {
        "speaker": "Lucy",
        "text": "No, she wasn't. Her friends were coming too.",
        "es": "No. Sus amigos también iban."
      }
    ],
