  "warmup": {
    "prompt_es": "¿Sabes nadar? ¿Sabes tocar la guitarra? En inglés se pregunta con una sola palabra: can."
  },
  "input": {
    "type": "dialogue",
    "lines": [
      {
        "speaker": "Sam",
        "text": "Can you swim, Lucy?",
        "es": "¿Sabes nadar, Lucy?"
      },
      {
        "speaker": "Lucy",
        "text": "Yes, I can. I can swim very well. But I can't play the guitar.",
        "es": "Sí. Nado muy bien. Pero no sé tocar la guitarra."
      },
      {
        "speaker": "Sam",
        "text": "I can't swim, but I can play the guitar. Can you sing?",
        "es": "Yo no sé nadar, pero sé tocar la guitarra. ¿Sabes cantar?"
      },
      {
        "speaker": "Lucy",
        "text": "No, I can't. Can you dance?",
        "es": "No. ¿Sabes bailar?"
      },
      {
        "speaker": "Sam",
        "text": "Yes, I can!",
        "es": "¡Sí!"
      }
    ],
    "glossary": [
      {
        "id": "en-can",
        "lemma": "can",
        "pos": "aux",
        "ipa": "/kæn/",
        "es": "poder, saber (habilidad)",
        "example": "I can swim."
      },
      {
        "id": "en-can-t",
