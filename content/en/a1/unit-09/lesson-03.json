  "explanation": {
    "md_es": [
      "**Can I…?** = ¿puedo…? (pido permiso) → *Can I open the window?*",
      "**Can you…?** = ¿puedes…? (pido un favor) → *Can you close the door?*",
      "",
      "**Añade *please*** para sonar más amable.",
      "",
      "**Responder:** *Yes, of course. / Sure. / Sorry, you can't.*",
      "",
      "Después de *can* va el verbo base: *Can you help me?* (no *Can you me help?*, ni *Can I to open…?*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "Can you me help?",
        "right": "Can you help me?",
        "note": "El verbo va justo después del sujeto."
      },
      {
        "wrong": "Can I to open?",
        "right": "Can I open?",
        "note": "Después de can no va to."
      }
    ],
    "false_friends": []
  },
