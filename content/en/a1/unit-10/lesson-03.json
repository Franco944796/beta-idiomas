  "explanation": {
    "md_es": [
      "**Ordinales:** 1st first · 2nd second · 3rd third · 4th fourth · 5th **fifth** · 6th sixth · 7th seventh · 8th **eighth** · 9th **ninth** · 10th tenth · 12th **twelfth** · 20th twentieth · 21st twenty-first",
      "",
      "**Regla:** número + **-th**, salvo 1.º, 2.º y 3.º. Cuidado con los cambios: *five → fifth, eight → eighth, nine → ninth, twelve → twelfth*.",
      "",
      "**Fechas (inglés británico):** *the fifth of May* (5 May). Se escribe *5th May* o *5 May*. En inglés americano: *May fifth*.",
      "",
      "**Preposición:** *on the fifth of May* · *in May*.",
      "",
      "**Preguntar:** *What's the date today? · When's your birthday?*"
    ],
    "common_mistakes_es": [
      {
        "wrong": "the five of May",
        "right": "the fifth of May",
        "note": "El día es un número ordinal."
      },
      {
        "wrong": "in the 21st of June",
        "right": "on the 21st of June",
        "note": "Con un día concreto se usa on."
      }
    ],
    "false_friends": []
  },
