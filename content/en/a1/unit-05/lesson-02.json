  "explanation": {
    "md_es": [
      "**Plural regular:** + **s** → *apple → apples, banana → bananas*.",
      "",
      "**+ es** si termina en *-s, -sh, -ch, -x, -o*: *sandwich → sandwiches, tomato → tomatoes, potato → potatoes*.",
      "",
      "**Consonante + y → -ies:** *strawberry → strawberries*.",
      "",
      "**Irregulares:** man → men · woman → women · child → children · person → people · foot → feet.",
      "",
      "Pronunciación de la -s: /s/ (cats), /z/ (bananas), /ɪz/ (sandwiches)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "two sandwichs",
        "right": "two sandwiches",
        "note": "Después de -ch se añade -es."
      },
      {
        "wrong": "three childs / peoples",
        "right": "three children / people",
        "note": "Son plurales irregulares."
      }
    ],
    "false_friends": []
  },
