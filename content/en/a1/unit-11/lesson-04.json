        "speaker": "Anna",
        "text": "Dan, I can't find my glasses. Where are they?",
        "es": "Dan, no encuentro mis anteojos. ¿Dónde están?"
      },
      {
        "speaker": "Dan",
        "text": "Are they on the table?",
        "es": "¿Están sobre la mesa?"
