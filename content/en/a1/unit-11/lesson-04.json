      },
      {
        "speaker": "Dan",
        "text": "Look in your bag.",
        "es": "Mira en tu bolso."
      },
      {
        "speaker": "Anna",
        "text": "My bag? OK… no, they aren't here.",
        "es": "¿Mi bolso? Bien… no, no están aquí."
      },
      {
        "speaker": "Dan",
        "text": "Wait! They're in your pocket!",
        "es": "¡Espera! ¡Están en tu bolsillo!"
      },
      {
        "speaker": "Anna",
        "text": "Oh, thank you! And where's my phone?",
        "es": "¡Oh, gracias! ¿Y dónde está mi teléfono?"
      },
      {
        "speaker": "Dan",
        "text": "It's under the sofa.",
        "es": "Está debajo del sofá."
      }
