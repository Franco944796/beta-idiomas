  "explanation": {
    "md_es": [
      "**Preguntar:** *How much is the sandwich?* (singular) · *How much are the bananas?* (plural)",
      "",
      "**Responder:** *It's three pounds.* · *They're two pounds fifty.*",
      "",
      "**Precios:** £2.50 = *two pounds fifty* (o *two fifty*) · $5.99 = *five ninety-nine*",
      "",
      "**Monedas con -s:** *pounds, euros, dollars* (*two pounds*, no *two pound*).",
      "",
      "**cheap** = barato · **expensive** = caro."
    ],
    "common_mistakes_es": [
      {
        "wrong": "How much cost the bag?",
        "right": "How much is the bag?",
        "note": "Se usa 'is' o 'are', no 'cost'."
      },
      {
        "wrong": "two pound",
        "right": "two pounds",
        "note": "La moneda lleva -s en plural."
      }
    ],
