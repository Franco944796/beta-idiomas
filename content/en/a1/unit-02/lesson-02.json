  "explanation": {
    "md_es": [
      "| Sujeto | to be | Forma corta |",
      "|---|---|---|",
      "| he | is | he's |",
      "| she | is | she's |",
      "| it | is | it's |",
      "",
      "- **he** = un hombre · **she** = una mujer · **it** = una cosa o un animal.",
      "- El sujeto no se omite: *He's a teacher.* (no *Is a teacher*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "Is from Spain.",
        "right": "He's from Spain. / She's from Spain.",
        "note": "No se omite el sujeto."
      },
      {
        "wrong": "Anna is my friend. He is from Italy.",
        "right": "She is from Italy.",
        "note": "he = hombre, she = mujer."
      }
    ],
    "false_friends": []
  },
