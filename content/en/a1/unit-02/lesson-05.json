  "explanation": {
    "md_es": [
      "**What do you do?** = ¿A qué te dedicas? Respuesta: *I'm a / an + profesión.*",
      "",
      "**a** antes de sonido de consonante: *a teacher, a nurse*.",
      "**an** antes de sonido de vocal: *an engineer*.",
      "",
      "Importa el **sonido**, no la letra: *a university* (empieza con sonido /j/), *an hour* (la h no se pronuncia).",
      "",
      "En español omitimos el artículo (*soy médico*); en inglés es obligatorio: *I'm a doctor*."
    ],
    "common_mistakes_es": [
      {
        "wrong": "I'm teacher.",
        "right": "I'm a teacher.",
        "note": "En español omitimos el artículo; en inglés es obligatorio."
      },
      {
        "wrong": "I'm a engineer.",
        "right": "I'm an engineer.",
        "note": "Antes de sonido de vocal se usa 'an'."
      }
    ],
    "false_friends": []
  },
