  "explanation": {
    "md_es": [
      "**Lugares:** bank · supermarket · restaurant · café · hospital · school · park · station · post office · cinema · library · museum",
      "",
      "**Falso amigo:** *library* = **biblioteca** (no librería). Una librería es *bookshop* (o *bookstore* en americano).",
      "",
      "**Hay…:** *There's a park near my house.*",
      "",
      "Pronunciación: *museum* → mi-u-SÍ-am · *library* → LÁI-bre-ri · *station* → STÉI-shn."
    ],
    "common_mistakes_es": [
      {
        "wrong": "library = librería",
        "right": "library = biblioteca; bookshop = librería",
        "note": "Es un falso amigo."
      },
      {
        "wrong": "museum → 'museum' leído en español",
        "right": "museum /mjuˈziːəm/",
        "note": "Suena 'miuSÍam', con acento en la segunda sílaba."
      }
    ],
    "false_friends": [
      {
        "word": "library",
        "es_false": "librería",
        "real": "biblioteca",
        "note": "Librería = bookshop."
      }
    ]
  },
