  "explanation": {
    "md_es": [
      "**Preguntar:** *How do I get to the station?* (¿cómo llego a la estación?)",
      "",
      "**Dar direcciones (imperativo):**",
      "- *Go straight on.* (siga recto)",
      "- *Turn left / right.* (gire a la izquierda / derecha)",
      "- *Take the first / second / third left / right.* (tome la primera, segunda… calle a la izquierda / derecha)",
      "- *at the traffic lights / at the corner*",
      "",
      "**Ubicar:** *It's on your left / on your right.* (con **on**, no *in*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "Turn to left.",
        "right": "Turn left.",
        "note": "No se usa 'to' con left / right."
      },
      {
        "wrong": "It's in the left.",
        "right": "It's on the left.",
        "note": "La posición izquierda / derecha va con 'on'."
      }
    ],
    "false_friends": []
  },
