  "explanation": {
    "md_es": [
      "**by + transporte** (sin artículo): *by bus · by train · by car · by taxi · by bike · by underground*.",
      "",
      "**A pie:** *on foot* o *walk*: *I go to school on foot.* = *I walk to school.*",
      "",
      "**Pregunta:** *How do you go to work?*",
      "",
      "No se dice *by the bus* ni *by foot*.",
      "",
      "Pronunciación: *walk* → 'uók' (la l no se pronuncia)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "by the bus",
        "right": "by bus",
        "note": "Con by no se usa artículo."
      },
      {
        "wrong": "by foot",
        "right": "on foot",
        "note": "A pie se dice 'on foot'."
      }
    ],
