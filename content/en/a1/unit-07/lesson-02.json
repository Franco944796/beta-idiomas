  "warmup": {
    "prompt_es": "Estás en una ciudad nueva y buscas un banco: ¿cómo preguntas dónde está?"
  },
  "input": {
    "type": "dialogue",
    "lines": [
      {
        "speaker": "Tourist",
        "text": "Excuse me, where's the bank?",
        "es": "Disculpe, ¿dónde está el banco?"
      },
      {
        "speaker": "Lucy",
        "text": "It's next to the supermarket.",
        "es": "Está al lado del supermercado."
      },
      {
        "speaker": "Tourist",
        "text": "Is it far?",
        "es": "¿Está lejos?"
      },
      {
        "speaker": "Lucy",
        "text": "No, it's near. It's opposite the park.",
        "es": "No, está cerca. Está enfrente del parque."
      }
    ],
    "glossary": [
      {
        "id": "en-where-s",
        "lemma": "where's",
        "pos": "phrase",
        "ipa": "/weəz/",
        "es": "¿dónde está? (where is)",
        "example": "Where's the bank?"
      },
      {
        "id": "en-far",
        "lemma": "far",
        "pos": "adv",
        "ipa": "/fɑː/",
        "es": "lejos",
        "example": "Is it far?"
      },
      {
        "id": "en-opposite",
        "lemma": "opposite",
        "pos": "prep",
        "ipa": "/ˈɒpəzɪt/",
        "es": "enfrente de",
        "example": "The bank is opposite the park."
      },
      {
        "id": "en-near-here",
        "lemma": "near here",
        "pos": "phrase",
        "ipa": "/nɪə ˈhɪə/",
        "es": "cerca de aquí",
        "example": "Is there a bank near here?"
      }
    ],
    "audio_script_id": "en-a1-u07-l02-d01"
  },
  "explanation": {
    "md_es": [
      "**Preguntar:** *Where's the bank?* (= *Where is…*) · *Is there a bank near here?*",
      "",
      "**Responder:** *It's + preposición + lugar* → *It's next to the supermarket.*",
      "",
      "Nuevas palabras de lugar: **opposite** (enfrente de), **near** (cerca de), **far from** (lejos de).",
      "",
      "**Es lejos / cerca:** *Is it far? — No, it's near.*",
      "",
      "No omitas el sujeto: *It's next to…* (no *Is next to…*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "Where the bank is?",
        "right": "Where is the bank?",
        "note": "En preguntas el verbo va antes del sujeto."
      },
      {
        "wrong": "Is next to the park.",
        "right": "It's next to the park.",
        "note": "En inglés el sujeto no se omite."
      }
    ],
    "false_friends": []
  },
