  "title": {
    "target": "Where is...?",
    "es": "¿Dónde está...?"
  },
  "objective": "Al terminar preguntas dónde está un lugar y respondes con preposiciones y distancias.",
  "est_minutes": 28,
  "skills": [
    "grammar",
