    "lines": [
      {
        "speaker": "Sam",
        "text": "Excuse me. Can you help me, please? Where's the museum?",
        "es": "Disculpe. ¿Puede ayudarme, por favor? ¿Dónde está el museo?"
      },
      {
        "speaker": "Officer",
        "text": "Sure. Don't turn left. Turn right at the park.",
        "es": "Claro. No gire a la izquierda. Gire a la derecha en el parque."
      },
      {
        "speaker": "Sam",
        "text": "Thank you very much!",
        "es": "¡Muchas gracias!"
      },
      {
        "speaker": "Officer",
        "text": "You're welcome. Be careful!",
        "es": "De nada. ¡Tenga cuidado!"
      }
    ],
