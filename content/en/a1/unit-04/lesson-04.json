    "lines": [
      {
        "speaker": "Sam",
        "text": "Do you work on Saturdays, Lucy?",
        "es": "¿Trabajas los sábados, Lucy?"
      },
      {
        "speaker": "Lucy",
        "text": "No, I don't. I don't work on Saturdays.",
        "es": "No. No trabajo los sábados."
      },
      {
        "speaker": "Sam",
        "text": "What time do you get up?",
        "es": "¿A qué hora te levantas?"
      },
      {
        "speaker": "Lucy",
        "text": "I get up at eight. Does your brother get up early?",
        "es": "Me levanto a las ocho. ¿Tu hermano se levanta temprano?"
      },
      {
        "speaker": "Sam",
        "text": "No, he doesn't. He gets up late.",
        "es": "No. Se levanta tarde."
      }
    ],
