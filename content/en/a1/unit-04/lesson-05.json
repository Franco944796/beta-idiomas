  "explanation": {
    "md_es": [
      "**Días:** Monday · Tuesday · Wednesday · Thursday · Friday · Saturday · Sunday. Siempre con **mayúscula**.",
      "",
      "**on + día:** *on Monday(s)* (sin artículo).",
      "",
      "| Adverbio | Frecuencia |",
      "|---|---|",
      "| always | 100 % |",
      "| usually | ~80 % |",
      "| often | ~60 % |",
      "| sometimes | ~30 % |",
      "| never | 0 % |",
      "",
      "**Posición:** antes del verbo principal (*She always gets up*) y después de *to be* (*She is always late*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "I go always to work.",
        "right": "I always go to work.",
        "note": "El adverbio va antes del verbo principal."
      },
      {
        "wrong": "monday / on the Monday",
        "right": "on Monday",
        "note": "Los días llevan mayúscula y no llevan artículo."
      }
    ],
    "false_friends": []
  },
