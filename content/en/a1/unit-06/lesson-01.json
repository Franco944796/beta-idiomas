  "explanation": {
    "md_es": [
      "**Habitaciones:** kitchen · living room · bedroom · bathroom · garden",
      "",
      "**Muebles y objetos:** bed · table · chair · sofa · lamp · window · door",
      "",
      "**house** (casa) y **flat** (piso, inglés británico; en americano se dice *apartment*).",
      "",
      "**Ojo:** *toilet* es el inodoro o el aseo; *bathroom* es el baño de la casa.",
      "",
      "Pronunciación: *sofa* → 'sóufa' · *kitchen* → 'kíchen' · *chair* → 'cheə'."
    ],
    "common_mistakes_es": [
      {
        "wrong": "toilet = baño de la casa",
        "right": "bathroom = baño; toilet = inodoro",
        "note": "Son cosas distintas."
      },
      {
        "wrong": "sofa → 'sofa' con o corta",
        "right": "sofa /ˈsəʊfə/",
        "note": "La primera vocal suena 'ou'."
      }
    ],
    "false_friends": []
  },
