  "input": {
    "type": "text",
    "text": "There's a big kitchen in my flat. There are two bedrooms. There isn't a garden, but there are two windows in the living room. Is there a sofa? Yes, there is.",
    "es": "Hay una cocina grande en mi piso. Hay dos dormitorios. No hay jardín, pero hay dos ventanas en la sala. ¿Hay un sofá? Sí, hay.",
    "glossary": [
      {
        "id": "en-there-is",
        "lemma": "there is",
        "pos": "phrase",
        "ipa": "/ðeər ˈɪz/",
        "es": "hay (singular)",
        "example": "There's a sofa."
      },
      {
        "id": "en-there-are",
        "lemma": "there are",
        "pos": "phrase",
        "ipa": "/ðeər ˈɑː/",
        "es": "hay (plural)",
        "example": "There are two chairs."
      },
      {
        "id": "en-big",
        "lemma": "big",
        "pos": "adj",
        "ipa": "/bɪɡ/",
        "es": "grande",
        "example": "There's a big kitchen."
