    "lines": [
      {
        "speaker": "Tom",
        "text": "Who's that?",
        "es": "¿Quién es ese?"
      },
      {
        "speaker": "Anna",
        "text": "That's Ben. He's Laura's brother.",
        "es": "Es Ben. Es el hermano de Laura."
      },
      {
        "speaker": "Tom",
        "text": "And who's that woman?",
        "es": "¿Y quién es esa mujer?"
      },
      {
        "speaker": "Anna",
        "text": "That's Laura's mother. Her name is Sue.",
        "es": "Es la madre de Laura. Se llama Sue."
      },
      {
        "speaker": "Tom",
        "text": "Is Sue a teacher?",
        "es": "¿Sue es profesora?"
      },
      {
        "speaker": "Anna",
        "text": "No, she's a nurse. Sue's a nurse.",
        "es": "No, es enfermera."
      }
