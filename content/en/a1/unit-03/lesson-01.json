  "explanation": {
    "md_es": [
      "**Familia:** mother (mum) · father (dad) · brother · sister · son · daughter · husband · wife · grandmother · grandfather · parents.",
      "",
      "**mum** es inglés británico; en americano se dice *mom*.",
      "",
      "**Plural:** se añade *-s*: *brother → brothers*, *sister → sisters*.",
      "",
      "**Falso amigo:** *parents* = padres (mamá y papá). *Parientes* = *relatives*."
    ],
    "common_mistakes_es": [
      {
        "wrong": "Tom and Sam are brother.",
        "right": "Tom and Sam are brothers.",
        "note": "Con más de uno se añade -s."
      },
      {
        "wrong": "my parents = mis parientes",
        "right": "parents = padres; relatives = parientes",
        "note": "Es un falso amigo."
      }
    ],
    "false_friends": [
      {
        "word": "parents",
        "es_false": "parientes",
        "real": "padres",
        "note": "'Parientes' se dice relatives."
      }
    ]
  },
