  "explanation": {
    "md_es": [
      "**Los adjetivos no cambian** con el género ni con el número: *a tall man, a tall woman, tall people*.",
      "",
      "**Posición:**",
      "- después de *to be*: *She is tall.*",
      "- **antes** del sustantivo: *a tall woman* (nunca *a woman tall*).",
      "",
      "No se añade *-s*: *They are tall* (no *talls*)."
    ],
    "common_mistakes_es": [
      {
        "wrong": "a woman tall",
        "right": "a tall woman",
        "note": "En inglés el adjetivo va antes del sustantivo."
      },
      {
        "wrong": "They are talls.",
        "right": "They are tall.",
        "note": "Los adjetivos no cambian en plural."
      }
    ],
    "false_friends": []
  },
