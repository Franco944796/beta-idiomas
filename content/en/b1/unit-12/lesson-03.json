    "lines": [
      {
        "speaker": "Anna",
        "text": "I love running in the morning.",
        "es": "Me encanta correr por la mañana."
      },
      {
        "speaker": "Ben",
        "text": "So do I. I run every day before work.",
        "es": "A mí también. Corro cada día antes de trabajar."
      },
      {
        "speaker": "Anna",
        "text": "I've never run a marathon.",
        "es": "Nunca he corrido un maratón."
      },
      {
        "speaker": "Ben",
        "text": "Neither have I. But I'm planning to run one next year.",
        "es": "Yo tampoco. Pero pienso correr uno el año que viene."
      },
      {
        "speaker": "Anna",
        "text": "I can't run more than ten kilometres.",
        "es": "No puedo correr más de diez kilómetros."
      },
      {
        "speaker": "Ben",
        "text": "Neither can I. Not yet, anyway.",
        "es": "Yo tampoco. Todavía no, al menos."
      },
      {
        "speaker": "Anna",
        "text": "I was really nervous before my first race.",
        "es": "Estaba muy nerviosa antes de mi primera carrera."
      },
      {
        "speaker": "Ben",
        "text": "So was I. And I didn't sleep the night before.",
        "es": "Yo también. Y no dormí la noche anterior."
      },
      {
        "speaker": "Anna",
        "text": "I didn't either. I'll be there tomorrow, though.",
        "es": "Yo tampoco. Pero mañana estaré allí."
      },
      {
        "speaker": "Ben",
        "text": "So will I. See you at the start!",
        "es": "Yo también. ¡Nos vemos en la salida!"
      }
    ],
