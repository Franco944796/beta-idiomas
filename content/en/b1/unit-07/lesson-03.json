  "warmup": {
    "prompt_es": "'Me preguntó dónde vivía.' 'Me pidió que esperase.' En el estilo indirecto, las preguntas pierden su orden interrogativo y las órdenes se reportan con infinitivo."
  },
  "input": {
    "type": "dialogue",
    "lines": [
      {
        "speaker": "Ana",
        "text": "How was the job interview? What did they ask you?",
        "es": "¿Qué tal la entrevista? ¿Qué te preguntaron?"
      },
      {
        "speaker": "Leo",
        "text": "The manager asked me where I had worked before and why I had left my last job.",
        "es": "El director me preguntó dónde había trabajado antes y por qué había dejado mi último trabajo."
      },
      {
        "speaker": "Ana",
        "text": "And did she ask if you could start soon?",
        "es": "¿Y te preguntó si podías empezar pronto?"
      },
      {
        "speaker": "Leo",
        "text": "Yes, she asked whether I was available immediately. I said I could start the next Monday.",
        "es": "Sí, me preguntó si estaba disponible de inmediato. Dije que podía empezar el lunes siguiente."
      },
      {
        "speaker": "Ana",
        "text": "Did she tell you anything about the salary?",
        "es": "¿Te dijo algo del sueldo?"
      },
      {
        "speaker": "Leo",
        "text": "I asked her how much the position paid, and she told me not to worry: it was a good package.",
        "es": "Le pregunté cuánto pagaban el puesto y me dijo que no me preocupara: era un buen paquete."
      },
      {
        "speaker": "Ana",
        "text": "Did she ask you to send anything?",
        "es": "¿Te pidió que enviaras algo?"
      },
      {
        "speaker": "Leo",
        "text": "Yes, she asked me to send my references and told me to call her on Friday.",
        "es": "Sí, me pidió que enviara mis referencias y me dijo que la llamara el viernes."
      }
    ],
